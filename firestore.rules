rules_version = '2';

// Access matrix: specs/001-foundation-signin/contracts/firestore-access.md
// Tests: tests/rules/firestore.rules.test.ts (npm run test:rules)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email is string;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    // Invited = verified Google email with an entry in /allowlist/{lowercased email}.
    function isInvited() {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/allowlist/$(myEmail()));
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // Managed by the owner in the Firebase console. A person may read only their own entry,
    // so the app can tell "not invited" from "offline".
    match /allowlist/{email} {
      allow get: if signedIn() && email == myEmail();
    }

    match /users/{uid} {
      // The profile (003) is a map when present.
      allow get: if isInvited() && isOwner(uid);
      allow create, update: if isInvited() && isOwner(uid)
        && (!('profile' in request.resource.data) || request.resource.data.profile is map);

      // Favourite / Not for me per exercise. Clearing a mark deletes the document.
      match /exerciseMarks/{exerciseId} {
        allow read, delete: if isInvited() && isOwner(uid);
        allow create, update: if isInvited() && isOwner(uid)
          && request.resource.data.keys().hasOnly(['mark', 'updatedAt'])
          && request.resource.data.mark in ['favourite', 'notForMe'];
      }

      // Saved sets (004): the person's own ordered exercise lists.
      match /sets/{setId} {
        allow read, delete: if isInvited() && isOwner(uid);
        allow create, update: if isInvited() && isOwner(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 60
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 40;
      }

      // Kept plans (006): one per routine and length, id `{routine}-{minutes}`.
      match /plans/{planId} {
        allow read, delete: if isInvited() && isOwner(uid);
        allow create, update: if isInvited() && isOwner(uid)
          && request.resource.data.routine in ['calm', 'desk', 'strength', 'weekend', 'cardio']
          && request.resource.data.minutes is number
          && request.resource.data.minutes >= 5
          && request.resource.data.minutes <= 90
          && request.resource.data.items is list
          && request.resource.data.items.size() >= 1
          && request.resource.data.items.size() <= 40;
      }

      // One document per player run. No deletes: history is kept.
      match /sessions/{sessionId} {
        allow read: if isInvited() && isOwner(uid);
        allow create, update: if isInvited() && isOwner(uid)
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 50;
      }
    }

    // Every new collection or subcollection needs its own match block.
    // Anything not matched above is denied.
  }
}
